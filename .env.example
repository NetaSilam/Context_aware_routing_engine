# Copy to .env and fill in real values. Never commit the real .env file.

# Copy this file to .env and replace every placeholder before running Compose.
# These values are deliberately unusable examples, not development secrets.
POSTGRES_DB=replace_with_database_name
POSTGRES_USER=replace_with_database_user
POSTGRES_PASSWORD=replace_with_database_password
DATABASE_URL=postgresql+psycopg://replace_user:replace_password@postgres:5432/replace_database
REDIS_URL=redis://redis:6379/0
FOUNDATION_DATA_VERSION=replace_with_foundation_version
RISK_DATA_VERSION=replace_with_risk_data_version
FOUNDATION_DATA_MODE=fixture
# Required only when FOUNDATION_DATA_MODE=verify.
FOUNDATION_DATA_CHECKSUM=replace_with_verified_source_checksum
JWT_SECRET=replace_with_a_long_random_secret
AUTH_ALLOWED_ORIGIN=http://localhost:5173
OSRM_BASE_URL=http://osrm:5000/
EXPECTED_OSRM_GRAPH_VERSION=replace_with_osrm_graph_version
AUTH_COOKIE_SECURE=false
FRONTEND_PORT=5173

# LLM (pick whichever provider you use)
GEMINI_API_KEY=your_secret_api_key_here
OPENAI_API_KEY=your_secret_api_key_here
HUGGINGFACE_API_KEY=your_secret_api_key_here
