# Copy to .env.real and replace the local secret placeholders.
COMPOSE_PROJECT_NAME=road-risk-real
POSTGRES_DB=road_risk
POSTGRES_USER=road_risk
POSTGRES_PASSWORD=replace_with_a_local_database_password
DATABASE_URL=postgresql+psycopg://road_risk:replace_with_a_local_database_password@postgres:5432/road_risk
REDIS_URL=redis://redis:6379/0

# These versions identify the prepared artifacts and derived risk snapshot.
FOUNDATION_DATA_VERSION=national-foundation-2026-08-01
FOUNDATION_DATA_MODE=real
FOUNDATION_DATA_PATH=/data
# Optional pin for the committed artifact set. Leave empty to compute without pinning.
FOUNDATION_DATA_CHECKSUM=c3d6e0eeec723a139917f19a53cca2ee2ab7701aa1e75578870d52b10eb9a45c
RISK_DATA_VERSION=national-risk-2026-08-01

JWT_SECRET=replace_with_a_long_random_secret
AUTH_ALLOWED_ORIGIN=http://localhost:8080
AUTH_COOKIE_SECURE=false
OSRM_BASE_URL=http://osrm:5000/
EXPECTED_OSRM_GRAPH_VERSION=israel-palestine-2026-07-31-osrm-6.0.0-profile-v1
OSRM_DEPLOYMENT_MANIFEST_PATH=/osrm/deployment-compatibility.json
OSRM_COMPATIBILITY_REQUIRED=true
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org/search
GEOCODER_USER_AGENT=replace_with_identifying_application_and_contact
FRONTEND_PORT=8080
